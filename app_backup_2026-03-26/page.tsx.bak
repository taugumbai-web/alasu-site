"use client";

import { useEffect, useRef, useState } from "react";
import Link from "next/link";
import Footer from "./components/Footer";
import LanguageSelector, { Lang } from "./components/LanguageSelector";
import { BurgerMenu, useReveal, useLang } from "./components/shared";

/*
  ЛОГИКА:
  - Фон altai-1.jpg всегда закреплён (fixed), не меняется
  - Скролл 0–1vh:   текст 1 ("ALASU")
  - Скролл 1–2vh:   текст 2 ("ИСТОЧНИК")
  - Скролл 2–3vh:   текст 3 ("МИНЕРАЛЬНАЯ ВОДА")
  - После 3vh:      hero исчезает, появляется нижний контент
*/

const slides = [
    {
        title: { ru: "ALASU", kz: "ALASU", en: "ALASU", zh: "ALASU" },
        text: { ru: "Чистая сила природы Хан Тэнгри", kz: "Хан Тәңірінің табиғи таза суы", en: "Pure power of Khan Tengri", zh: "汗腾格里的纯净力量" },
    },
    {
        title: { ru: "ИСТОЧНИК", kz: "БАСТАУ", en: "SOURCE", zh: "来源" },
        text: { ru: "Холодные вершины и природная глубина", kz: "Салқын тау шыңдары", en: "Cold peaks and natural depth", zh: "寒冷的山峰与自然的深度" },
    },
    {
        title: { ru: "МИНЕРАЛЬНАЯ ВОДА", kz: "МИНЕРАЛДЫ СУ", en: "MINERAL WATER", zh: "矿泉水" },
        text: { ru: "Природный минеральный состав", kz: "Табиғи минерал құрамы", en: "Natural mineral composition", zh: "天然矿物质成分" },
    },
];

const stats = [
    { value: "7010", suffix: "m", label: { ru: "Высота источника", kz: "Бастау биіктігі", en: "Source altitude", zh: "水源海拔" } },
    { value: "7.8", suffix: "", label: { ru: "Уровень pH", kz: "pH деңгейі", en: "pH level", zh: "pH水平" } },
    { value: "100", suffix: "%", label: { ru: "Природная вода", kz: "Табиғи су", en: "Natural water", zh: "纯天然水" } },
    { value: "4", suffix: "", label: { ru: "Вида продукции", kz: "Өнім түрі", en: "Product types", zh: "产品种类" } },
];

/* ─── Counter ───────────────────────────────────────────────────── */
function Counter({ target, suffix }: { target: string; suffix: string }) {
    const [display, setDisplay] = useState("0");
    const ref = useReveal();
    useEffect(() => {
        if (!ref.visible) return;
        const num = parseFloat(target);
        const isFloat = target.includes(".");
        const start = performance.now();
        const tick = (now: number) => {
            const p = Math.min((now - start) / 1800, 1);
            const val = num * (1 - Math.pow(1 - p, 3));
            setDisplay(isFloat ? val.toFixed(1) : Math.floor(val).toString());
            if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
    }, [ref.visible, target]);
    return <span ref={ref.ref} className="tabular-nums">{display}{suffix}</span>;
}

/* ─── Stats ─────────────────────────────────────────────────────── */
function StatsSection({ lang }: { lang: Lang }) {
    const reveal = useReveal();
    return (
        <section ref={reveal.ref}
            className="relative z-40 bg-[#061842] py-16 sm:py-24 border-t border-white/[0.05]"
            style={{ opacity: reveal.visible ? 1 : 0, transform: reveal.visible ? "none" : "translateY(40px)", transition: "opacity 0.9s ease, transform 0.9s ease" }}>
            <div className="max-w-6xl mx-auto px-4 sm:px-6">
                <div className="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
                    {stats.map((s, i) => (
                        <div key={i} className="text-center"
                            style={{ opacity: reveal.visible ? 1 : 0, transform: reveal.visible ? "none" : "translateY(30px)", transition: `opacity 0.7s ${i * 0.12}s ease, transform 0.7s ${i * 0.12}s ease` }}>
                            <div className="text-3xl sm:text-4xl md:text-5xl font-black text-white mb-2">
                                <Counter target={s.value} suffix={s.suffix} />
                            </div>
                            <p className="text-[10px] sm:text-xs text-white/40 tracking-[0.2em] uppercase font-light">{s.label[lang]}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    );
}

/* ─── Mountain + form ───────────────────────────────────────────── */
function MountainGraphic({ lang, sendWhatsApp }: { lang: Lang; sendWhatsApp: (e: React.FormEvent<HTMLFormElement>) => void }) {
    const sectionRef = useRef<HTMLDivElement>(null);
    const [drawn, setDrawn] = useState(false);
    const reveal = useReveal();
    useEffect(() => {
        const el = sectionRef.current;
        if (!el) return;
        const obs = new IntersectionObserver(([e]) => setDrawn(e.isIntersecting), { threshold: 0.15 });
        obs.observe(el);
        return () => obs.disconnect();
    }, []);
    return (
        <section id="partner" ref={sectionRef} className="relative z-40 bg-[#061842] w-full pt-16 sm:pt-20 pb-24 sm:pb-32 overflow-hidden">
            <div className="absolute inset-0 pointer-events-none" style={{ background: "radial-gradient(ellipse 80% 50% at 50% 100%, rgba(59,130,246,0.12) 0%, transparent 80%)" }} />
            <div className="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 flex flex-col items-center">
                <svg viewBox="0 0 500 180" className="mb-8 pointer-events-none select-none w-[200px] h-[65px] sm:w-[280px] sm:h-[90px]" fill="none" style={{ overflow: "visible" }}>
                    <defs>
                        <radialGradient id="formMglow" cx="50%" cy="90%" r="55%">
                            <stop offset="0%" stopColor="#3b82f6" stopOpacity="0.2" />
                            <stop offset="100%" stopColor="#3b82f6" stopOpacity="0" />
                        </radialGradient>
                    </defs>
                    <ellipse cx="250" cy="162" rx="200" ry="28" fill="url(#formMglow)" />
                    <path d="M0,162 L55,130 L90,140 L140,95 L175,110 L215,70 L255,85 L285,55 L320,75 L365,115 L410,98 L460,130 L500,162"
                        stroke="#3b82f6" strokeWidth="1" strokeLinecap="round" strokeLinejoin="round" opacity="0.2" />
                    <path className={drawn ? "mountain-line-animated" : "mountain-line-reset"}
                        d="M8,162 L45,138 L68,145 L105,112 L122,120 L155,82 L172,92 L195,58 L208,68 L222,48 L228,42 L250,8 L272,42 L278,48 L292,68 L305,58 L328,92 L345,82 L378,120 L395,112 L432,145 L455,138 L492,162"
                        stroke="#93c5fd" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
                </svg>
                <div ref={reveal.ref}
                    style={{ opacity: reveal.visible ? 1 : 0, transform: reveal.visible ? "none" : "translateY(40px)", transition: "opacity 0.9s ease, transform 0.9s ease" }}
                    className="max-w-4xl w-full text-center relative z-20">
                    <h2 className="text-3xl sm:text-4xl md:text-5xl font-black text-white mb-8 sm:mb-10 uppercase tracking-wide drop-shadow-lg">
                        {lang === "ru" ? "Оставьте вашу заявку" : lang === "kz" ? "Өтініміңізді қалдырыңыз" : lang === "en" ? "Leave your request" : "留下您的请求"}
                    </h2>
                    <form onSubmit={sendWhatsApp} className="grid sm:grid-cols-3 gap-4 sm:gap-5 bg-[#071c52]/30 backdrop-blur-2xl p-6 sm:p-10 rounded-[2rem] sm:rounded-[2.5rem] border border-white/10 shadow-2xl">
                        <input name="name" placeholder={lang === "ru" ? "Имя" : lang === "kz" ? "Аты-жөніңіз" : lang === "en" ? "Name" : "姓名"} required
                            className="bg-white/[0.03] border border-white/10 px-5 sm:px-6 py-4 rounded-2xl text-white placeholder-white/20 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all font-light text-sm sm:text-base" />
                        <input name="phone" placeholder={lang === "ru" || lang === "kz" ? "Телефон" : lang === "en" ? "Phone" : "电话"} required
                            className="bg-white/[0.03] border border-white/10 px-5 sm:px-6 py-4 rounded-2xl text-white placeholder-white/20 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all font-light text-sm sm:text-base" />
                        <button type="submit" className="sweep-btn bg-blue-600 hover:bg-blue-500 text-white font-black tracking-[0.2em] uppercase py-4 rounded-2xl shadow-lg hover:shadow-blue-500/40 transition-all duration-300 text-sm sm:text-base">
                            {lang === "ru" ? "Отправить" : lang === "kz" ? "Жіберу" : lang === "en" ? "Send" : "发送"}
                        </button>
                    </form>
                    <p className="mt-8 sm:mt-10 text-white/20 text-[10px] tracking-[0.3em] font-light uppercase">
                        {lang === "ru" ? "Мы свяжемся с вами в ближайшее время" : lang === "kz" ? "Біз сізге жақын арада хабарласамыз" : lang === "en" ? "We will contact you shortly" : "我们会尽快与您联系"}
                    </p>
                </div>
            </div>
        </section>
    );
}

/* ═══════════════════════════════════════════════════════════════════ */
export default function Home() {
    const [lang, setLang] = useLang();
    const [menu, setMenu] = useState(false);
    const [scrollY, setScrollY] = useState(0);
    const [vh, setVh] = useState(800);
    const [slideIdx, setSlideIdx] = useState(0);   // какой текст показываем
    const [heroVisible, setHeroVisible] = useState(true);

    const [preloader, setPreloader] = useState(true);
    const [preOut, setPreOut] = useState(false);

    /* vh при монтировании и ресайзе */
    useEffect(() => {
        const update = () => setVh(window.innerHeight);
        update();
        window.addEventListener("resize", update);
        return () => window.removeEventListener("resize", update);
    }, []);

    /* Preloader */
    useEffect(() => {
        document.body.style.overflow = "hidden";
        const t1 = setTimeout(() => setPreOut(true), 2600);
        const t2 = setTimeout(() => { setPreloader(false); document.body.style.overflow = ""; }, 3200);
        return () => { clearTimeout(t1); clearTimeout(t2); };
    }, []);

    /* Scroll */
    useEffect(() => {
        const onScroll = () => {
            const y = window.scrollY;
            setScrollY(y);

            // Текущий слайд: каждый занимает 1 × vh
            const idx = Math.min(slides.length - 1, Math.floor(y / vh));
            setSlideIdx(idx);

            // Hero исчезает после прокрутки всех слайдов (3 × vh)
            setHeroVisible(y < slides.length * vh - 20);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        return () => window.removeEventListener("scroll", onScroll);
    }, [vh]);

    /* Menu lock */
    useEffect(() => {
        if (!preloader) document.body.style.overflow = menu ? "hidden" : "";
        return () => { if (!preloader) document.body.style.overflow = ""; };
    }, [menu, preloader]);

    const sendWhatsApp = (e: React.FormEvent<HTMLFormElement>) => {
        e.preventDefault();
        const f = e.currentTarget;
        const name = (f.elements.namedItem("name") as HTMLInputElement).value;
        const phone = (f.elements.namedItem("phone") as HTMLInputElement).value;
        window.open(`https://wa.me/77008878887?text=Имя: ${name}%0AТелефон: ${phone}`, "_blank");
    };

    const slide = slides[slideIdx];

    return (
        <>
            {/* Preloader */}
            {preloader && (
                <div className={`fixed inset-0 z-[999] flex flex-col items-center justify-center bg-[#010c1f] ${preOut ? "pre-out" : ""}`}>
                    <svg viewBox="0 0 500 180" className="w-[260px] h-[93px] sm:w-[420px] sm:h-[150px]" fill="none" style={{ overflow: "visible" }}>
                        <defs>
                            <radialGradient id="mglow" cx="50%" cy="90%" r="55%">
                                <stop offset="0%" stopColor="#3b82f6" stopOpacity="0.22" />
                                <stop offset="100%" stopColor="#3b82f6" stopOpacity="0" />
                            </radialGradient>
                            <linearGradient id="peakGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stopColor="#e0f2fe" stopOpacity="0.9" />
                                <stop offset="60%" stopColor="#93c5fd" stopOpacity="0.8" />
                                <stop offset="100%" stopColor="#60a5fa" stopOpacity="0.5" />
                            </linearGradient>
                        </defs>
                        <ellipse cx="250" cy="162" rx="200" ry="28" fill="url(#mglow)" />
                        <path d="M0,162 L55,130 L90,140 L140,95 L175,110 L215,70 L255,85 L285,55 L320,75 L365,115 L410,98 L460,130 L500,162"
                            stroke="#3b82f6" strokeWidth="1" strokeLinecap="round" strokeLinejoin="round" opacity="0.18" />
                        <path className="pre-mountain"
                            d="M8,162 L45,138 L68,145 L105,112 L122,120 L155,82 L172,92 L195,58 L208,68 L222,48 L228,42 L250,8 L272,42 L278,48 L292,68 L305,58 L328,92 L345,82 L378,120 L395,112 L432,145 L455,138 L492,162"
                            stroke="url(#peakGrad)" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" />
                        <circle cx="250" cy="8" r="2.5" fill="#e0f2fe" opacity="0" style={{ animation: "preTagIn 0.4s ease-out 2.0s both" }} />
                        <text x="268" y="4" fill="#93c5fd" fontSize="9" fontFamily="Inter, sans-serif" fontWeight="500" letterSpacing="0.05em" opacity="0"
                            style={{ animation: "preTagIn 0.5s ease-out 2.3s both" }}>4 506 m</text>
                    </svg>
                    <p className="pre-logo mt-8 text-white font-black uppercase select-none" style={{ fontSize: "clamp(1.4rem,4vw,2.2rem)", letterSpacing: "0.35em" }}>ALASU</p>
                    <p className="pre-tag mt-3 text-[10px] text-blue-300/50 tracking-[0.5em] uppercase font-light select-none">Khan Tengri · 7010m · Natural · Water</p>
                </div>
            )}

            <style>{`
                @keyframes drawMountainPre { from{stroke-dashoffset:900} to{stroke-dashoffset:0} }
                .pre-mountain { stroke-dasharray:900; stroke-dashoffset:900; animation:drawMountainPre 2s cubic-bezier(0.4,0,0.2,1) 0.3s forwards; }
                @keyframes preLogoIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }
                .pre-logo { animation:preLogoIn 0.8s ease-out 1.8s both; }
                @keyframes preTagIn { from{opacity:0} to{opacity:1} }
                .pre-tag  { animation:preTagIn 0.6s ease-out 2.2s both; }
                @keyframes preFadeOut { from{opacity:1} to{opacity:0} }
                .pre-out  { animation:preFadeOut 0.6s ease-out forwards; }

                @keyframes scrollBounce {
                    0%,100%{transform:translateY(0);opacity:0.3}
                    50%{transform:translateY(6px);opacity:1}
                }
                .smooth-arrow { animation:scrollBounce 1.6s ease-in-out infinite; display:block; }

                .sweep-btn { position:relative; overflow:hidden; }
                .sweep-btn::after {
                    content:''; position:absolute; top:0; left:-80%;
                    width:60%; height:100%;
                    background:linear-gradient(120deg,transparent 0%,rgba(255,255,255,0.18) 50%,transparent 100%);
                    transition:left 0.5s ease;
                }
                .sweep-btn:hover::after { left:130%; }

                @keyframes drawElegantMountain { from{stroke-dashoffset:1200} to{stroke-dashoffset:0} }
                .mountain-line-animated { stroke-dasharray:1200; stroke-dashoffset:0; animation:drawElegantMountain 2.5s cubic-bezier(0.4,0,0.2,1) forwards; }
                .mountain-line-reset    { stroke-dasharray:1200; stroke-dashoffset:1200; }

                /* Текст появляется при смене слайда */
                @keyframes slideTextIn {
                    from { opacity:0; transform:translateY(20px); }
                    to   { opacity:1; transform:none; }
                }
                .slide-text { animation: slideTextIn 0.5s ease-out both; }
            `}</style>

            {/* ── Spacer: 3×100vh — пространство для скролла текстов ─ */}
            <div style={{ height: `${slides.length * 100}vh` }} aria-hidden="true" />

            {/* ── Нижний контент — появляется после hero ──────────── */}
            <div className="relative z-30 bg-[#061842]">
                <StatsSection lang={lang} />
                <MountainGraphic lang={lang} sendWhatsApp={sendWhatsApp} />
                <Footer lang={lang} />
            </div>

            {/* ── Header ──────────────────────────────────────────── */}
            <header className="fixed top-0 left-0 right-0 z-[200] border-b border-white/[0.08] backdrop-blur-xl bg-[#061842]/60">
                <div className="flex justify-between items-center px-5 sm:px-8 md:px-12 py-3.5">
                    <Link href="/" className="no-underline group">
                        <span className="text-lg sm:text-xl font-black tracking-[0.25em] text-white select-none transition-all duration-500 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-cyan-300 group-hover:via-white group-hover:to-blue-400">
                            ALASU
                        </span>
                    </Link>
                    <div className="flex items-center gap-3 sm:gap-6">
                        <LanguageSelector lang={lang} setLang={setLang} position="bottom" />
                        <button onClick={() => setMenu(true)} aria-label="Open menu"
                            className="group relative flex flex-col justify-center items-center gap-[5px] w-10 h-10 rounded-full border border-white/15 bg-white/5 hover:bg-white/10 hover:border-white/35 backdrop-blur-sm transition-all duration-300 cursor-pointer">
                            <span className="block w-[18px] h-[1.5px] bg-white/80 rounded-full group-hover:w-[22px] group-hover:bg-white transition-all duration-300" />
                            <span className="block w-[14px] h-[1.5px] bg-white/50 rounded-full group-hover:w-[22px] group-hover:bg-white/80 transition-all duration-300" />
                            <span className="block w-[10px] h-[1.5px] bg-white/30 rounded-full group-hover:w-[22px] group-hover:bg-white/60 transition-all duration-300" />
                        </button>
                    </div>
                </div>
            </header>

            {/* ── Fixed hero: закреплённый фон + меняющийся текст ─── */}
            <div style={{
                position: "fixed",
                inset: 0,
                zIndex: 20,
                opacity: heroVisible ? 1 : 0,
                pointerEvents: heroVisible ? "auto" : "none",
                transition: "opacity 0.6s ease",
            }}>
                {/* Фон — один, неподвижный */}
                <div
                    className="absolute inset-0 bg-cover bg-center"
                    style={{ backgroundImage: "url(/altai-1.jpg)" }}
                />

                {/* Затемнение */}
                <div className="absolute inset-0 pointer-events-none"
                    style={{ background: "linear-gradient(to bottom, rgba(0,0,0,0.08), rgba(0,0,0,0.55))" }} />

                {/* Текст — key меняется → React пересоздаёт → анимация запускается */}
                <div className="relative z-20 flex h-full flex-col items-center justify-center text-center px-4 sm:px-6 pb-24">
                    <div key={slideIdx} className="slide-text flex flex-col items-center">
                        <span className="mb-4 sm:mb-6 inline-flex items-center gap-2 sm:gap-3 text-[9px] sm:text-[11px] tracking-[0.35em] uppercase text-white/45 font-medium">
                            <span className="inline-block w-6 sm:w-8 h-px bg-white/25" />
                            Alasu · Kazakhstan
                            <span className="inline-block w-6 sm:w-8 h-px bg-white/25" />
                        </span>
                        <h1 className="font-black leading-none uppercase tracking-[0.06em] drop-shadow-2xl text-white"
                            style={{ fontSize: "clamp(2.2rem, 9vw, 5.2rem)" }}>
                            {slide.title[lang]}
                        </h1>
                        <p className="mt-4 sm:mt-5 text-sm sm:text-base md:text-lg text-white/70 font-light tracking-wide max-w-xs sm:max-w-md leading-relaxed">
                            {slide.text[lang]}
                        </p>
                    </div>

                    {/* Dots */}
                    <div className="absolute bottom-14 sm:bottom-16 left-1/2 -translate-x-1/2 flex gap-3 sm:gap-4">
                        {slides.map((_, i) => (
                            <span key={i} className={`block rounded-full transition-all duration-500 ${i === slideIdx ? "w-5 sm:w-6 h-[3px] bg-white" : "w-1.5 h-[3px] bg-white/30"}`} />
                        ))}
                    </div>

                    {/* Стрелки */}
                    <div className="absolute bottom-5 sm:bottom-6 left-1/2 -translate-x-1/2 pointer-events-none select-none flex flex-col items-center">
                        <span className="smooth-arrow text-[10px] text-white/60" style={{ animationDelay: "0s" }}>↓</span>
                        <span className="smooth-arrow text-[10px] text-white/60" style={{ animationDelay: "0.2s" }}>↓</span>
                        <span className="smooth-arrow text-[10px] text-white/60" style={{ animationDelay: "0.4s" }}>↓</span>
                    </div>
                </div>
            </div>

            <BurgerMenu open={menu} onClose={() => setMenu(false)} lang={lang} />
        </>
    );
}
